{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "authoring_record_multi_evidence_v1.schema.json",
  "title": "Private source-grounded epistemic multi-evidence authoring record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ruleset_id",
    "item_id",
    "family_id",
    "topic_id",
    "comparison_id",
    "relation_id",
    "condition_role",
    "split",
    "claim",
    "evidence_catalog",
    "ordered_evidence_ids",
    "gold",
    "transformation_log",
    "record_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "ruleset_id": {
      "const": "epistemic_relation_rules_v1"
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "topic_id": {
      "type": "string",
      "minLength": 1
    },
    "comparison_id": {
      "type": "string",
      "minLength": 1
    },
    "relation_id": {
      "type": "string",
      "enum": [
        "claim_certainty_weakening_v1",
        "claim_scope_universal_to_existential_v1",
        "claim_causal_to_associational_v1",
        "evidence_independent_corroboration_v1",
        "evidence_exact_duplication_v1",
        "evidence_matched_conflict_v1",
        "evidence_single_axis_scope_mismatch_v1",
        "evidence_order_reversal_v1",
        "evidence_corroboration_vs_duplicate_v1"
      ]
    },
    "condition_role": {
      "type": "string",
      "enum": [
        "reference",
        "intervention",
        "order_variant"
      ]
    },
    "split": {
      "type": "string",
      "enum": [
        "construction",
        "dev",
        "test"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "text",
        "variant_role",
        "pico"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "variant_role": {
          "type": "string",
          "enum": [
            "fixed",
            "stronger",
            "weaker"
          ]
        },
        "pico": {
          "$ref": "#/$defs/pico"
        }
      }
    },
    "evidence_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "source_group_id",
          "passage_text",
          "passage_sha256",
          "provenance",
          "pico",
          "construction_role",
          "independence_status",
          "human_review_status"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "source_group_id": {
            "type": "string",
            "minLength": 1
          },
          "passage_text": {
            "type": "string",
            "minLength": 1
          },
          "passage_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_title",
              "source_url",
              "pmid",
              "doi",
              "nct_id",
              "source_locator",
              "license_or_access_note",
              "exact_text_verified"
            ],
            "properties": {
              "source_title": {
                "type": "string",
                "minLength": 1
              },
              "source_url": {
                "type": "string",
                "minLength": 1
              },
              "pmid": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "doi": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "nct_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_locator": {
                "type": "string",
                "minLength": 1
              },
              "license_or_access_note": {
                "type": "string",
                "minLength": 1
              },
              "exact_text_verified": {
                "const": true
              }
            }
          },
          "pico": {
            "$ref": "#/$defs/pico"
          },
          "construction_role": {
            "type": "string",
            "enum": [
              "base_support",
              "independent_support",
              "matched_conflict",
              "scope_mismatch",
              "insufficient"
            ]
          },
          "independence_status": {
            "type": "string",
            "enum": [
              "base",
              "verified_independent",
              "same_source",
              "not_applicable",
              "unclear"
            ]
          },
          "human_review_status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          }
        }
      }
    },
    "ordered_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "per_evidence",
        "combined"
      ],
      "properties": {
        "per_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "relation_to_claim",
              "decisive_quote",
              "rationale",
              "human_review_status"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "relation_to_claim": {
                "type": "string",
                "enum": [
                  "supports",
                  "conflicts",
                  "insufficient",
                  "out_of_scope"
                ]
              },
              "decisive_quote": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "human_review_status": {
                "type": "string",
                "enum": [
                  "pending",
                  "approved",
                  "rejected"
                ]
              }
            }
          }
        },
        "combined": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acceptable_labels",
            "conflict_expected",
            "score_relation_to_reference",
            "expected_used_evidence_ids",
            "rationale",
            "human_review_status"
          ],
          "properties": {
            "acceptable_labels": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "supported",
                  "contradicted",
                  "unsupported",
                  "not_enough_evidence",
                  "mixed_evidence"
                ]
              }
            },
            "conflict_expected": {
              "type": "boolean"
            },
            "score_relation_to_reference": {
              "type": "string",
              "enum": [
                "higher",
                "equivalent",
                "lower",
                "not_scored"
              ]
            },
            "expected_used_evidence_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "human_review_status": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "rejected"
              ]
            }
          }
        }
      }
    },
    "transformation_log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_variable",
        "held_fixed_checks",
        "reviewer_notes"
      ],
      "properties": {
        "changed_variable": {
          "type": "string",
          "minLength": 1
        },
        "held_fixed_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewer_notes": {
          "type": "string"
        }
      }
    },
    "record_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    }
  },
  "$defs": {
    "pico": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population",
        "intervention_or_exposure",
        "comparator",
        "outcome",
        "direction",
        "dose",
        "time_point"
      ],
      "properties": {
        "population": {
          "type": "string"
        },
        "intervention_or_exposure": {
          "type": "string"
        },
        "comparator": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "dose": {
          "type": "string"
        },
        "time_point": {
          "type": "string"
        }
      }
    }
  }
}
