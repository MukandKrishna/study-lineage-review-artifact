{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model_input_multi_evidence_v1.schema.json",
  "title": "Leak-free epistemic multi-evidence model input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "item_id",
    "claim_id",
    "claim_text",
    "evidence_bundle"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_text": {
      "type": "string",
      "minLength": 1
    },
    "evidence_bundle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bundle_position",
          "evidence_id",
          "source_group_id",
          "passage_text"
        ],
        "properties": {
          "bundle_position": {
            "type": "integer",
            "minimum": 1
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "source_group_id": {
            "type": "string",
            "minLength": 1
          },
          "passage_text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
