# Copy this file to .env and fill in the key locally.
# Never commit .env.
# GPT-5.6 Sol/Terra/Luna use `codex login` with ChatGPT subscription auth.
# Do not put an OpenAI Platform API key in this project.

# Vertex AI service-account settings. The JSON key itself is ignored by Git.
GOOGLE_APPLICATION_CREDENTIALS=default-eyeconai-main-project-key.json
GOOGLE_CLOUD_PROJECT=eyeconai-main
GOOGLE_CLOUD_LOCATION=eu
